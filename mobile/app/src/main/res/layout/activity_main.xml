<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="青鸟·口袋版"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="未启动"
            android:textSize="13sp"
            android:paddingBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="① 权限"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnA11y"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="无障碍"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnNotif"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="通知权限"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnShot"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="截屏授权"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnBattery"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="电池白名单"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnWizard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="新手向导（推荐首次使用点这里）"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="② 模型（本地 GGUF 或 云端 DeepSeek）"
            android:textStyle="bold"
            android:paddingTop="8dp" />

        <Button
            android:id="@+id/btnImportModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="导入本地 GGUF 模型（.gguf）"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/edCloudBase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="云端 API Base（可选，如 https://api.deepseek.com）"
            android:inputType="textUri"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/edCloudKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="云端 API Key（可选，sk- 开头）"
            android:inputType="textPassword"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnCloud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="使用云端模式"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="③ 启动青鸟（前台服务）"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="④ 给她派任务"
            android:textStyle="bold"
            android:paddingTop="8dp" />

        <EditText
            android:id="@+id/edTask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="例如：打开QQ给主人发消息说我到了 / 打开设置看看蓝牙开了没"
            android:inputType="text"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnRun"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="执行任务"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnClearQueue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="清空任务队列"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="运行日志"
            android:textStyle="bold"
            android:paddingTop="10dp" />

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:text="（尚无日志）"
            android:background="#14000000"
            android:padding="8dp" />
    </LinearLayout>
</ScrollView>
