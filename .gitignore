# ============================================================
# qingniao 根仓库 .gitignore
# 原则：只进「代码 + 配置模板 + 文档」；不进凭据、运行时状态、第三方大件、个人内容。
# ============================================================

# ---------- 凭据 / 本地配置 ----------
config/suite.json
*.local.json
*.bak
*.bak-*
qq-bridge/config.json

# ---------- 运行时产物 ----------
state/
logs/
*.log
*.tmp
*.pid
*.lock
bili-duty/out/
bili-duty/tmp/
bili-duty/reports/
bili-duty/digest/
bili-duty/seen.md
bili-duty/state.json
bili-duty/verify-state.json
bili-duty/dm-lock.json
bili-duty/dm-others.json
bili-duty/local-override.json
bili-duty/mcp_server.py.new
bili-duty/install.log
bili-duty/.probe.txt
bili-duty/_probe*.txt
bili-duty/_write_probe.txt
bili-duty/.write-probe
bili-duty/.write-test*
__pycache__/
*.pyc

# ---------- Python 环境 ----------
bili-duty/.venv/
bili-duty/.venv-asr/
tools/voice/.venv/

# ---------- Node ----------
node_modules/

# ---------- SnowLuma：第三方发行包，EULA 禁止再分发，不入库 ----------
SnowLuma/

# ---------- 个人内容（不随代码走） ----------
memory/
pictures/
docs/
test/fixtures/*.wav
qq-bridge/assets/*.jpeg

# ---------- 语音素材（个人音色，可用 train_sovits.sh 自行重建） ----------
tools/voice/datasets/
tools/voice/models/
tools/voice/models-uvr/
tools/voice/dl/
tools/voice/refs/
tools/gptsovits/GPT-SoVITS/
tools/gptsovits/.venv/
tools/gptsovits/*.zip
tools/gptsovits/*.whl
tools/gptsovits/tmp_s2_*.json
tools/gptsovits/data_exp.list

